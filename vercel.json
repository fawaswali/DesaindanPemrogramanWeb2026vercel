{
  "version": 2,
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.7.3"
    },
    {
      "src": "jobsheet-*/**",
      "use": "@vercel/static"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/([^?]*\\.(?:css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|html))$",
      "dest": "/$1"
    },
    {
      "src": "^/(jobsheet-[^?]*\\.php.*)$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/(jobsheet-[^?]*)$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    }
  ]
}